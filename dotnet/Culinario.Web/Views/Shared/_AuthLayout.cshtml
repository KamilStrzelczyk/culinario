<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Culinario</title>
    <!-- Bootswatch Minty Theme -->
    <link rel="stylesheet" href="https://bootswatch.com/5/minty/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #78c2ad 0%, #f3969a 100%);
            min-height: 100vh;
        }
        .auth-card {
            border-radius: 20px;
            border: none;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
        .auth-logo {
            font-size: 3rem;
            color: #78c2ad;
        }
    </style>
</head>
<body>
    <div class="container">
        <main role="main" class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
            <div class="card auth-card p-5" style="width: 100%; max-width: 450px;">
                <div class="text-center mb-4">
                    <i class="bi bi-egg-fried auth-logo"></i>
                    <h1 class="fw-bold mt-2 text-primary">Culinario</h1>
                    <p class="text-muted">Cook, Share, Enjoy</p>
                </div>
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
