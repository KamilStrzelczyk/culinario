@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-egg-fried display-1 text-primary"></i>
    </div>
    <h1 class="display-3 fw-bold mb-3">Welcome to Culinario</h1>
    <p class="lead text-muted mb-5">Discover delicious recipes, create your own, and share with the world.</p>

    <div class="d-flex justify-content-center gap-3">
        <a class="btn btn-primary btn-lg px-5" asp-controller="Recipes" asp-action="Index">
            <i class="bi bi-search"></i> Browse Recipes
        </a>
        <a class="btn btn-outline-primary btn-lg px-5" asp-controller="Recipes" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>
</div>

<div class="row mt-5 g-4">
    <div class="col-md-4">
        <div class="card h-100 text-center p-4">
            <div class="card-body">
                <i class="bi bi-journal-bookmark display-4 text-secondary mb-3"></i>
                <h3 class="card-title">Organize</h3>
                <p class="card-text">Keep all your favorite recipes in one place.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center p-4">
            <div class="card-body">
                <i class="bi bi-basket display-4 text-secondary mb-3"></i>
                <h3 class="card-title">Shop</h3>
                <p class="card-text">Generate shopping lists directly from recipes.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center p-4">
            <div class="card-body">
                <i class="bi bi-share display-4 text-secondary mb-3"></i>
                <h3 class="card-title">Share</h3>
                <p class="card-text">Share your culinary masterpieces with friends.</p>
            </div>
        </div>
    </div>
</div>
