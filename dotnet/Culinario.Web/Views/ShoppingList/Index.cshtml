@model IEnumerable<Culinario.Application.DTOs.ShoppingListDTO>

@{
    ViewData["Title"] = "Shopping Lists";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Shopping Lists</h1>
    <a asp-action="Create" class="btn btn-success btn-lg">
        <i class="bi bi-plus-lg"></i> Create New List
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <h4>No shopping lists found!</h4>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <a asp-action="Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action flex-column align-items-start">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">@item.Title</h5>
                    <small>@item.Items.Count items</small>
                </div>
                <p class="mb-1">@item.Description</p>
            </a>
        }
    </div>
}
