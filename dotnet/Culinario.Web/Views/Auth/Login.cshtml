@model Culinario.Application.DTOs.LoginRequestDTO

@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<h2 class="text-center mb-4">Log in</h2>

<form asp-action="Login">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-3">
        <label asp-for="Username" class="control-label"></label>
        <input asp-for="Username" class="form-control" placeholder="Enter username" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Password" class="control-label"></label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group d-grid gap-2">
        <input type="submit" value="Log in" class="btn btn-primary btn-lg" />
    </div>
</form>

<div class="mt-3 text-center">
    <p>Don't have an account? <a asp-action="Register">Register here</a></p>
</div>
