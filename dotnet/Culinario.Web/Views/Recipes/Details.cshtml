@model Culinario.Application.DTOs.RecipeDTO

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Recipes</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">@Model.Title</h2>
                <span class="badge bg-light text-dark">@Model.Category</span>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h4 class="text-primary">Description</h4>
                    <p class="lead">@Model.Description</p>

                    <hr />

                    <h4 class="text-primary">Preparation Steps</h4>
                    <div class="accordion" id="stepsAccordion">
                        @for (int i = 0; i < Model.Steps.Count; i++)
                        {
                            var step = Model.Steps[i];
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@i">
                                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@i" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse-@i">
                                        <strong>Step @(i + 1):</strong> &nbsp; @step.Title
                                    </button>
                                </h2>
                                <div id="collapse-@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading-@i" data-bs-parent="#stepsAccordion">
                                    <div class="accordion-body" style="white-space: pre-line;">
                                        @step.Description
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4 border-start">
                    <h5 class="text-muted">Details</h5>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item"><strong>Owner:</strong> @Model.Owner</li>
                        <li class="list-group-item"><strong>Created:</strong> @Model.Created</li>
                    </ul>

                    @if (Model.ShoppingListId.HasValue && Model.ShoppingListId > 0)
                    {
                        <div class="d-grid gap-2 mb-4">
                            <a asp-controller="ShoppingList" asp-action="Details" asp-route-id="@Model.ShoppingListId" class="btn btn-info">
                                <i class="bi bi-cart-check"></i> View Shopping List
                            </a>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure?');">
                            <button type="submit" class="btn btn-danger w-100">Delete Recipe</button>
                        </form>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
