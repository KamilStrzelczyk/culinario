@model Culinario.Application.DTOs.RecipeDTO

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Recipes</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">@Model.Title</h2>
                <span class="badge bg-light text-dark">@Model.Category</span>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h4 class="text-primary">Description</h4>
                    <p class="lead">@Model.Description</p>

                    <hr />

                    <h4 class="text-primary">Preparation Steps</h4>
                    <div class="card bg-light mb-3">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Step.Title</h5>
                            <p class="card-text" style="white-space: pre-line">@Model.Step.Description</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 border-start">
                    <h5 class="text-muted">Details</h5>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item">
                            <strong>Owner:</strong> @Model.Owner
                        </li>
                        <li class="list-group-item">
                            <strong>Created:</strong> @Model.Created
                        </li>
                        @if (Model.ShoppingListId > 0)
                        {
                            <li class="list-group-item">
                                <strong>Shopping List ID:</strong> @Model.ShoppingListId
                                <!-- Tu można dodać link do podglądu listy zakupów -->
                            </li>
                        }
                    </ul>

                    <div class="d-grid gap-2">
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                            <button type="submit" class="btn btn-danger w-100">Delete Recipe</button>
                        </form>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
